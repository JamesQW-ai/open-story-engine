  "facts": [
    {
      "id": "fact_3c3addc34bfb",
      "text": "临潮站的电子钟停在二十三点十分。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_001",
      "lineRange": {
        "start": 5,
        "end": 5
      }
    },
    {
      "id": "fact_997344d1bae5",
      "text": "末班列车停在那里，车窗里一排排空座位浮在湿漉漉的夜色中，车门紧闭，像一条没有开口的鱼。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_001",
      "lineRange": {
        "start": 7,
        "end": 7
      }
    },
    {
      "id": "fact_596eb647b7d3",
      "text": "语音的发送时间是二十二点五十五分。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_001",
      "lineRange": {
        "start": 17,
        "end": 17
      }
    },
    {
      "id": "fact_85bf99de76e9",
      "text": "十五分钟后，许川赶到临潮站，唐栖的电话已经无法接通。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_001",
      "lineRange": {
        "start": 17,
        "end": 17
      }
    },
    {
      "id": "fact_31b06bac8110",
      "text": "候车厅的红色电子钟仍停在二十三点十分，像在替所有人保守一个即将被冲开的秘密。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_003",
      "lineRange": {
        "start": 107,
        "end": 107
      }
    },
    {
      "id": "fact_d276971701e8",
      "text": "别让陈砚拿到储物柜里的录音。隧道里还有人。",
      "sourceChapterId": "chapter-001",
      "sourceProgress": "chapter_001",
      "lineRange": {
        "start": 13,
        "end": 13
      },
      "communication": {
        "speakerName": "唐栖",
        "kind": "语音"
      }
    }
  ],
  "timeline": [
    {
      "id": "timeline_d33985f0ce11",
      "order": 1,
      "knownAtStart": true,
      "description": "十五分钟后，许川赶到临潮站，唐栖的电话已经无法接通。"
    },
    {
      "id": "timeline_329371d53663",
      "order": 2,
      "knownAtStart": false,
      "description": "陈砚按住对讲机，背对着众人说：“零点前必须恢复放行。线路不能一直占着。”"
    }
  ],
  "beats": [
    {
      "id": "beat_chapter_001",
      "nodeId": "node_source_continuity",
      "summary": "十五分钟后，许川赶到临潮站，唐栖的电话已经无法接通。",
      "narrativeBrief": [
        {
          "text": "临潮站的电子钟停在二十三点十分。",
          "evidenceParagraphId": "paragraph-001",
          "lineRange": {
            "start": 5,
            "end": 5
          }
        },
        {
          "text": "它并不是真的坏了。红色的数字每隔一秒轻轻暗一下，又在下一秒亮回来，像一颗不肯认输的心脏。候车厅的玻璃门外，雨被海风推成斜线，扑在站台的黄灯上。",
          "evidenceParagraphId": "paragraph-002",
          "lineRange": {
            "start": 7,
            "end": 7
          }
        },
        {
          "text": "许川站在候车厅中央，第三次点开唐栖发来的语音。",
          "evidenceParagraphId": "paragraph-003",
          "lineRange": {
            "start": 9,
            "end": 9
          }
        },
        {
          "text": "录音只有十九秒。前半段全是风声和急促的脚步，唐栖的声音被雷声切得断断续续。",
          "evidenceParagraphId": "paragraph-004",
          "lineRange": {
            "start": 11,
            "end": 11
          }
        },
        {
          "text": "“别让陈砚拿到储物柜里的录音。隧道里还有人。”",
          "evidenceParagraphId": "paragraph-005",
          "lineRange": {
            "start": 13,
            "end": 13
          }
        },
        {
          "text": "最后一个“人”字拖得很轻，随后是金属门猛然合上的巨响。",
          "evidenceParagraphId": "paragraph-006",
          "lineRange": {
            "start": 15,
            "end": 15
          }
        },
        {
          "text": "语音的发送时间是二十二点五十五分。十五分钟后，许川赶到临潮站，唐栖的电话已经无法接通。站里的信号显示全线临时管制，外部通信被暴雨打断，只剩一盏盏在潮气里发白的灯。",
          "evidenceParagraphId": "paragraph-007",
          "lineRange": {
            "start": 17,
            "end": 17
          }
        }
      ],
      "actionContract": {
