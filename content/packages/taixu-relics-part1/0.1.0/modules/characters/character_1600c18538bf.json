{
  "schemaVersion": "story-package-character-module/0.1",
  "package": {
    "id": "taixu-relics-part1",
    "version": "0.1.0"
  },
  "character": {
    "id": "character_1600c18538bf",
    "name": "顾氏",
    "role": "source_character",
    "description": "顾长离辨认出那是顾氏家族的记号，说明有人比他们更早离开山门。",
    "evidenceParagraphIds": [
      "paragraph-061"
    ],
    "initialLocationId": null,
    "tags": [
      "source_character"
    ],
    "sourceDescriptionEvidence": [
      {
        "text": "瓶身没有宗门印记，只有一道被磨平的顾氏纹路。",
        "chapterId": "chapter-001",
        "lineRange": {
          "start": 125,
          "end": 125
        }
      },
      {
        "text": "账单边缘露出两个字：顾氏。",
        "chapterId": "chapter-003",
        "lineRange": {
          "start": 415,
          "end": 415
        }
      },
      {
        "text": "铜环上刻着细密的横纹，和第三章那张顾氏账单上的印记一致。",
        "chapterId": "chapter-004",
        "lineRange": {
          "start": 583,
          "end": 583
        }
      },
      {
        "text": "她把纸摊在膝上，指尖压住“顾氏”二字，随后沿着下方残缺的墨线慢慢读：“第三盏灯，送入西坡旧井。",
        "chapterId": "chapter-005",
        "lineRange": {
          "start": 659,
          "end": 659
        }
      },
      {
        "text": "陆照临用断木拨开淤积，摸到一块刻着顾氏旧纹的石片。",
        "chapterId": "chapter-005",
        "lineRange": {
          "start": 787,
          "end": 787
        }
      },
      {
        "text": "“顾氏账房。",
        "chapterId": "chapter-006",
        "lineRange": {
          "start": 907,
          "end": 907
        }
      },
      {
        "text": "红线缠了三圈，正是旧档中被抹去的顾氏记号。",
        "chapterId": "chapter-007",
        "lineRange": {
          "start": 1180,
          "end": 1180
        }
      },
      {
        "text": "顾长离隔着三个人，袖口压着顾氏账单。",
        "chapterId": "chapter-008",
        "lineRange": {
          "start": 1198,
          "end": 1198
        }
      },
      {
        "text": "三年前冬至前七日，顾氏旁支也有三名账房离开北地，目的地写的是无灯镇。",
        "chapterId": "chapter-009",
        "lineRange": {
          "start": 1430,
          "end": 1430
        }
      },
      {
        "text": "“因为顾氏账本里有你父亲的名字。",
        "chapterId": "chapter-009",
        "lineRange": {
          "start": 1490,
          "end": 1490
        }
      },
      {
        "text": "他取出残印按在纸上，纸页顿时渗出一段新的字迹，写着某年北河城大旱，顾氏曾借灯救民。",
        "chapterId": "chapter-009",
        "lineRange": {
          "start": 1530,
          "end": 1530
        }
      },
      {
        "text": "“因为顾氏账本？",
        "chapterId": "chapter-010",
        "lineRange": {
          "start": 1624,
          "end": 1624
        }
      },
      {
        "text": "路引上盖着顾氏旁支的印，日期正是冬至前七日。",
        "chapterId": "chapter-010",
        "lineRange": {
          "start": 1628,
          "end": 1628
        }
      },
      {
        "text": "黑灰里混着一粒细小的铜屑，与顾氏账单上的印记相同。",
        "chapterId": "chapter-011",
        "lineRange": {
          "start": 1775,
          "end": 1775
        }
      },
      {
        "text": "顾长离辨认出那是顾氏家族的记号，说明有人比他们更早离开山门。",
        "chapterId": "chapter-011",
        "lineRange": {
          "start": 1885,
          "end": 1885
        }
      },
      {
        "text": "“顾氏旁支？",
        "chapterId": "chapter-013",
        "lineRange": {
          "start": 2212,
          "end": 2212
        }
      },
      {
        "text": "妇人摇头：“我不认识顾氏。",
        "chapterId": "chapter-013",
        "lineRange": {
          "start": 2214,
          "end": 2214
        }
      },
      {
        "text": "灯罩内的金光映出一段模糊影像：三个人站在雪地里，其中一个穿着玄霄宗旧式斗篷，肩上扛着灯杆；另一个佩着顾氏铜环；第三个人的脸被光遮住。",
        "chapterId": "chapter-014",
        "lineRange": {
          "start": 2358,
          "end": 2358
        }
      },
      {
        "text": "陆照临写下父亲的姓名，顾长离写下顾氏旧债，叶观澜却迟迟不落笔。",
        "chapterId": "chapter-015",
        "lineRange": {
          "start": 2683,
          "end": 2683
        }
      },
      {
        "text": "顾长离走到碑后，发现一排浅孔，孔距与顾氏账房常用的铜钉一致。",
        "chapterId": "chapter-016",
        "lineRange": {
          "start": 2709,
          "end": 2709
        }
      },
      {
        "text": "影像没有声音，却能看出其中一人佩着顾氏铜环，另一人穿着归墟盟旧式青衫。",
        "chapterId": "chapter-016",
        "lineRange": {
          "start": 2771,
          "end": 2771
        }
      },
      {
        "text": "铜牌背面刻着半句童谣，与旧档中的顾氏歌谣相同。",
        "chapterId": "chapter-016",
        "lineRange": {
          "start": 2868,
          "end": 2868
        }
      },
      {
        "text": "“顾氏旁支的旧印。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2888,
          "end": 2888
        }
      },
      {
        "text": "楼门紧闭，门上却嵌着一枚顾氏旧印。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2938,
          "end": 2938
        }
      },
      {
        "text": "“灵脉城封存：东门、南门、城心灯柱七座；经手顾氏三人，玄霄宗一人，归墟盟一人。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2942,
          "end": 2942
        }
      },
      {
        "text": "顾长离盯着顾氏印记，指尖开始发白。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2946,
          "end": 2946
        }
      },
      {
        "text": "顾氏身影将一盏灯推入地下，玄霄宗身影举剑封门，归墟盟身影则把一张写满名字的纸撕成两半。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2972,
          "end": 2972
        }
      },
      {
        "text": "“我要找顾氏的名字。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 2996,
          "end": 2996
        }
      },
      {
        "text": "陆照临看向她手中的顾氏旧印，又看向黑铁门后不断传来的拖行声。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 3024,
          "end": 3024
        }
      },
      {
        "text": "“你早就知道顾氏参与封存？",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 3041,
          "end": 3041
        }
      },
      {
        "text": "她没有催他，只把那枚顾氏旧印握得更紧。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 3049,
          "end": 3049
        }
      },
      {
        "text": "顾氏旧印的来历藏在一间茶铺。",
        "chapterId": "chapter-017",
        "lineRange": {
          "start": 3065,
          "end": 3065
        }
      },
      {
        "text": "“顾氏旁支的一名经手人。",
        "chapterId": "chapter-018",
        "lineRange": {
          "start": 3123,
          "end": 3123
        }
      },
      {
        "text": "无相铜镜中，一段新的影像浮出：一个佩着顾氏铜环的男人站在城心，手里捧着第二盏灯。",
        "chapterId": "chapter-018",
        "lineRange": {
          "start": 3135,
          "end": 3135
        }
      },
      {
        "text": "顾长离把顾氏旧印举起：“你见过这个？",
        "chapterId": "chapter-019",
        "lineRange": {
          "start": 3365,
          "end": 3365
        }
      },
      {
        "text": "“顾氏的人把第二盏灯送出城，换走了三个人的名字。",
        "chapterId": "chapter-019",
        "lineRange": {
          "start": 3379,
          "end": 3379
        }
      },
      {
        "text": "名单上有三方签押，却没有顾氏名字。",
        "chapterId": "chapter-021",
        "lineRange": {
          "start": 3825,
          "end": 3825
        }
      },
      {
        "text": "顾长离看着山谷：“顾氏旧库。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4029,
          "end": 4029
        }
      },
      {
        "text": "柱上顾氏旧印已经被刮去，只留一圈浅痕。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4043,
          "end": 4043
        }
      },
      {
        "text": "门后是顾氏旧库。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4045,
          "end": 4045
        }
      },
      {
        "text": "“用顾氏的债。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4057,
          "end": 4057
        }
      },
      {
        "text": "“顾长离，顾氏旁支第七代，继承未偿债一笔。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4067,
          "end": 4067
        }
      },
      {
        "text": "“顾氏的债不按出生算，按印记算。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4071,
          "end": 4071
        }
      },
      {
        "text": "“顾氏把它叫债。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4087,
          "end": 4087
        }
      },
      {
        "text": "最后一页有三处手印：顾氏、玄霄宗、归墟盟。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4091,
          "end": 4091
        }
      },
      {
        "text": "“这是我唯一能证明顾氏说谎的东西。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4109,
          "end": 4109
        }
      },
      {
        "text": "第一盏灯旁写着“玄霄”，第二盏灯旁写着“顾氏”，第三盏灯旁却没有名字，只有一道空白。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4117,
          "end": 4117
        }
      },
      {
        "text": "玄霄宗弟子的声音从外面传来：“顾长离，交还顾氏旧印。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4155,
          "end": 4155
        }
      },
      {
        "text": "身后，顾氏旧库开始燃烧。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4187,
          "end": 4187
        }
      },
      {
        "text": "顾氏旧债的债主找上门来，是一名在城门卖糖人的老人。",
        "chapterId": "chapter-023",
        "lineRange": {
          "start": 4211,
          "end": 4211
        }
      },
      {
        "text": "顾氏旧库燃烧的同一夜，玄霄宗收到了一封没有署名的信。",
        "chapterId": "chapter-024",
        "lineRange": {
          "start": 4225,
          "end": 4225
        }
      },
      {
        "text": "“西坡旧阵、归墟灵城、顾氏封存工程。",
        "chapterId": "chapter-024",
        "lineRange": {
          "start": 4245,
          "end": 4245
        }
      },
      {
        "text": "“顾氏同意了吗？",
        "chapterId": "chapter-024",
        "lineRange": {
          "start": 4265,
          "end": 4265
        }
      },
      {
        "text": "“顾氏有人同意，有人拒绝。",
        "chapterId": "chapter-024",
        "lineRange": {
          "start": 4267,
          "end": 4267
        }
      },
      {
        "text": "第一盏灯下站着玄霄宗的人，第二盏灯下站着顾氏的人，第三盏灯下站着一个没有脸的人。",
        "chapterId": "chapter-025",
        "lineRange": {
          "start": 4499,
          "end": 4499
        }
      },
      {
        "text": "灰袍修士看向她：“顾氏后代，你也有债。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4639,
          "end": 4639
        }
      },
      {
        "text": "”灰袍修士继续道，“可顾氏的债契还在宗门。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4643,
          "end": 4643
        }
      },
      {
        "text": "“你若拒绝，顾氏所有旁支都将被列为封存工程同谋。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4651,
          "end": 4651
        }
      },
      {
        "text": "一名穿黑斗篷的人从雾中出现，手里捧着顾氏旧印。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4697,
          "end": 4697
        }
      },
      {
        "text": "“顾氏债契，转交玄霄宗。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4711,
          "end": 4711
        }
      },
      {
        "text": "石室门上刻着一个陌生姓氏，笔画却与顾氏旧印相同。",
        "chapterId": "chapter-026",
        "lineRange": {
          "start": 4797,
          "end": 4797
        }
      },
      {
        "text": "镜中先出现一座顾氏祠堂，年轻的顾长离站在门外，听见族老宣读债契。",
        "chapterId": "chapter-027",
        "lineRange": {
          "start": 4917,
          "end": 4917
        }
      },
      {
        "text": "族老说：“顾氏欠灵脉一盏灯，欠玄霄宗三名经手人，欠后代一条命。",
        "chapterId": "chapter-027",
        "lineRange": {
          "start": 4919,
          "end": 4919
        }
      },
      {
        "text": "纸上第一行是“陆沉舟”，第二行是一个被墨涂黑的叶姓，第三行是顾氏旧印。",
        "chapterId": "chapter-027",
        "lineRange": {
          "start": 4945,
          "end": 4945
        }
      },
      {
        "text": "顾长离把顾氏旧印按上去，石板立刻亮起。",
        "chapterId": "chapter-028",
        "lineRange": {
          "start": 5045,
          "end": 5045
        }
      },
      {
        "text": "债契黑纹被铜针截断，鲜血顺着针尾流下，在地面画出一个顾氏旧印。",
        "chapterId": "chapter-030",
        "lineRange": {
          "start": 5569,
          "end": 5569
        }
      },
      {
        "text": "她将证词举过头顶，声音传遍宗门：“三年前，玄霄宗、顾氏、归墟盟共同封存灵脉城。",
        "chapterId": "chapter-033",
        "lineRange": {
          "start": 6180,
          "end": 6180
        }
      },
      {
        "text": "盟主看向她颈侧的债契：“顾氏后代，你已经交过一次。",
        "chapterId": "chapter-034",
        "lineRange": {
          "start": 6318,
          "end": 6318
        }
      },
      {
        "text": "“我不是顾氏的账。",
        "chapterId": "chapter-034",
        "lineRange": {
          "start": 6320,
          "end": 6320
        }
      },
      {
        "text": "玄霄宗继承守门，无相寺继承记录，顾氏继承债，归墟盟继承改写。",
        "chapterId": "chapter-035",
        "lineRange": {
          "start": 6622,
          "end": 6622
        }
      },
      {
        "text": "再往下，是顾氏旁支一串被削掉的名字。",
        "chapterId": "chapter-036",
        "lineRange": {
          "start": 6718,
          "end": 6718
        }
      },
      {
        "text": "“顾氏经手人，第三次点灯未完成。",
        "chapterId": "chapter-036",
        "lineRange": {
          "start": 6792,
          "end": 6792
        }
      },
      {
        "text": "叶观澜看向顾氏旧印：“那盏灯不是顾氏的。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6912,
          "end": 6912
        }
      },
      {
        "text": "“但顾氏有点亮它的方法。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6914,
          "end": 6914
        }
      },
      {
        "text": "血沿针身流下，在地面画出一条完整的顾氏旧印。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6918,
          "end": 6918
        }
      },
      {
        "text": "“顾氏把灯交给了我。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6926,
          "end": 6926
        }
      },
      {
        "text": "灯罩内没有灯芯，只有一道顾氏旧印。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6964,
          "end": 6964
        }
      },
      {
        "text": "顾长离闭上眼，开始念顾氏家族的旧账。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6984,
          "end": 6984
        }
      },
      {
        "text": "“顾氏旁支第七代，顾长离。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 6986,
          "end": 6986
        }
      },
      {
        "text": "顾氏旧印从地面升起，化作一枚铜环，套在她腕上。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 7022,
          "end": 7022
        }
      },
      {
        "text": "她看着镜中的自己，低声说：“顾长离，顾氏旁支第七代，债已归还，修行止于此。",
        "chapterId": "chapter-037",
        "lineRange": {
          "start": 7100,
          "end": 7100
        }
      },
      {
        "text": "镜面显示出门内三座石台，分别刻着玄霄宗、顾氏和归墟盟的印记。",
        "chapterId": "chapter-038",
        "lineRange": {
          "start": 7148,
          "end": 7148
        }
      },
      {
        "text": "灯罩内没有火，却映出三年前雪原的景象：陆沉舟把灯交给她，顾氏经手人站在一旁，归墟盟旧使者正在撕毁姓名纸。",
        "chapterId": "chapter-038",
        "lineRange": {
          "start": 7228,
          "end": 7228
        }
      },
      {
        "text": "你想知道母亲最后去了哪里，想知道顾氏为何灭门，想知道是谁改了你的命，只要踏过这道门，所有答案都会回来。",
        "chapterId": "chapter-039",
        "lineRange": {
          "start": 7374,
          "end": 7374
        }
      },
      {
        "text": "三盏灯、第二枚残印、顾氏旧债、沈砚秋删史的掌印，以及陆沉舟从名册中消失的记录，在雪城门前同时得到回应。",
        "chapterId": "chapter-043",
        "lineRange": {
          "start": 7940,
          "end": 7940
        }
      },
      {
        "text": "第一盏是玄霄宗旧灯，灯芯记录着北境守门人的签名；第二盏来自顾氏旧库，灯罩内藏着替罪债契；第三盏没有灯芯，只映出无相寺保存的失名者。",
        "chapterId": "chapter-043",
        "lineRange": {
          "start": 7942,
          "end": 7942
        }
      },
      {
        "text": "顾氏灭门并非发生在二十年前，而是在一百七十二年前。",
