  "character": {
    "id": "character_766c4e16f65d",
    "name": "叶观澜",
    "role": "source_character",
    "description": "叶观澜问：“你为何帮我们？",
    "evidenceParagraphIds": [
      "paragraph-041",
      "paragraph-045",
