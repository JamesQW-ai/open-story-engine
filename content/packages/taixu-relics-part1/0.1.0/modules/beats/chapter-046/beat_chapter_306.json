  "chapter": {
    "id": "chapter-046",
    "title": "天门前夜"
  },
  "beat": {
    "id": "beat_chapter_306",
    "nodeId": "node_source_continuity",
    "summary": "陆照临在旁签下自己的名字，随后把灯交给城门守卫。",
    "narrativeBrief": [
      {
        "text": "北河城广场中央，三条路在雨水里分开。左边铺着青石，通向旧城门；中间铺着碎砖，通向灵脉井；右边只压过一层白灰，尽头是老槐树。",
        "evidenceParagraphId": "paragraph-001",
        "lineRange": {
          "start": 8308,
          "end": 8308
        }
      },
      {
        "text": "执事先开口：“镇守。封住天门，维持三方旧阵，北境可以继续安稳。”",
        "evidenceParagraphId": "paragraph-002",
        "lineRange": {
          "start": 8310,
          "end": 8310
        }
      },
      {
        "text": "一个抱孩子的妇人问：“安稳要交什么？”",
        "evidenceParagraphId": "paragraph-003",
        "lineRange": {
          "start": 8312,
          "end": 8312
        }
      },
      {
        "text": "“每年登记一次记忆，交出与天门有关的那段过去。”",
        "evidenceParagraphId": "paragraph-004",
        "lineRange": {
          "start": 8314,
          "end": 8314
        }
      },
      {
        "text": "妇人低头看孩子。孩子正抓着她的衣角，显然听不懂大人的话，却本能地往后退了一步。",
        "evidenceParagraphId": "paragraph-005",
        "lineRange": {
          "start": 8316,
          "end": 8316
        }
      },
      {
        "text": "归墟盟使者指向中路：“破门。毁掉旧阵，把所有被藏起来的真相还给人间。”",
        "evidenceParagraphId": "paragraph-006",
        "lineRange": {
          "start": 8318,
          "end": 8318
        }
      },
      {
        "text": "慧闻走上白灰路。路面没有异象，只有孩子们提着空灯跟在后面。走到老槐树下，慧闻回头看见白灰被雨冲开，露出许多不同方向的脚印。",
        "evidenceParagraphId": "paragraph-019",
        "lineRange": {
          "start": 8344,
          "end": 8344
        }
      },
      {
        "text": "三方都走完自己的路后，陆照临问他们：“还要我替人间选吗？”",
        "evidenceParagraphId": "paragraph-020",
        "lineRange": {
          "start": 8346,
          "end": 8346
        }
      },
      {
        "text": "执事放下封灵钉：“镇守需要被监督。”",
        "evidenceParagraphId": "paragraph-021",
        "lineRange": {
          "start": 8348,
          "end": 8348
        }
      },
      {
        "text": "使者把盟库钥匙放在地上：“破门需要有人收容灾民。”",
        "evidenceParagraphId": "paragraph-022",
        "lineRange": {
          "start": 8350,
          "end": 8350
        }
      },
      {
        "text": "慧闻展开空册：“留白需要每十年重审一次，任何一方不得独占解释权。”",
        "evidenceParagraphId": "paragraph-023",
        "lineRange": {
          "start": 8352,
          "end": 8352
        }
      },
      {
        "text": "陆照临取出掌心残印。残印的温度一路传到胸口，提醒他无论选择哪条路，都有人会失去东西。他把残印按在三路交界处，青石、碎砖和白灰同时裂开，却没有一条路消失。",
        "evidenceParagraphId": "paragraph-024",
        "lineRange": {
          "start": 8354,
          "end": 8354
        }
      },
      {
        "text": "“我选留白。”他说，“不是因为它安全，而是因为只有这一条路允许后来的人改口。”",
        "evidenceParagraphId": "paragraph-025",
        "lineRange": {
          "start": 8356,
          "end": 8356
        }
      },
      {
        "text": "百姓没有欢呼。铁匠先走到白灰路上，接着是抱孩子的妇人。有人仍站在原地，有人转身回家。三方代表把各自的凭证留在广场，约定任何人都能查阅。",
        "evidenceParagraphId": "paragraph-026",
        "lineRange": {
          "start": 8358,
          "end": 8358
        }
      },
      {
        "text": "陆照临与陆沉舟在门下短暂相见。父亲没有劝他进入天门，只问他是否还记得北河城的雨声。陆照临诚实地说已经忘了。陆沉舟点头，说忘记也可以，只要有人愿意告诉他雨曾经来过。",
        "evidenceParagraphId": "paragraph-007",
        "lineRange": {
          "start": 8404,
          "end": 8404
        }
      },
      {
        "text": "夜色落下，河滩上的灯一盏接一盏亮起。每个人都带走自己的选择，也留下可供后来者追问的证据。",
        "evidenceParagraphId": "paragraph-008",
        "lineRange": {
          "start": 8406,
          "end": 8406
        }
      },
      {
        "text": "进入天门前的第三夜，白雨再次落下。陆照临让守灯人把灯架移到屋檐下，却发现雨水会沿着屋檐倒流，先浸湿灯芯，再落到地面。铁匠拆开一盏灯，发现灯油里混着细小的灰片，灰片上刻着陌生人的姓氏。",
        "evidenceParagraphId": "paragraph-009",
        "lineRange": {
          "start": 8408,
          "end": 8408
        }
      },
      {
        "text": "陆照临让抄写员把这些小事记在账册边角，不列为债务，只标明等待归还。守城少年带着人挨家挨户询问，许多居民起初不愿开门，担心记忆会带来新的征收。",
        "evidenceParagraphId": "paragraph-010",
        "lineRange": {
          "start": 8410,
          "end": 8410
        }
      },
      {
        "text": "灵脉井的云门比前夜更清晰。井水映出北方山门，却没有召唤任何人。陆照临把三盏灯分别放在井沿、街心和城门，观察光线如何交汇。",
        "evidenceParagraphId": "paragraph-011",
        "lineRange": {
          "start": 8412,
          "end": 8412
        }
      },
      {
        "text": "信是陆沉舟写给苏晚照的，内容很短，只说门若再开，先问人间是否准备好。陆照临读完没有带走信，而是把它放回床脚。父亲留下的问题不该成为他的命令。",
        "evidenceParagraphId": "paragraph-012",
        "lineRange": {
          "start": 8414,
          "end": 8414
        }
      },
      {
        "text": "夜半，灵脉井中忽然传出孩子的哭声。守灯人以为有人落井，放下绳索后却只捞出一只空木匣。木匣里装着被白雨带走的记忆碎片，每一片都对应城中一户人家。",
        "evidenceParagraphId": "paragraph-013",
        "lineRange": {
          "start": 8416,
          "end": 8416
        }
      },
      {
        "text": "天亮后，守灯人将昨夜的交接记录钉在城墙，任何居民都能查阅。陆照临没有删去自己的失误，反而在旁边写明修正办法。",
        "evidenceParagraphId": "paragraph-014",
        "lineRange": {
          "start": 8418,
          "end": 8418
        }
      },
      {
        "text": "守灯人把每盏灯的燃料来源写在木牌上，标明谁捐出、谁使用、何时补充。有人发现自己的名字被写错，便在旁边加注说明。陆照临逐一核对，没有把错误删掉，而是保留修改前后的笔迹。",
        "evidenceParagraphId": "paragraph-015",
        "lineRange": {
          "start": 8420,
          "end": 8420
        }
      },
      {
        "text": "城门守卫接过探路图，承诺每隔一刻钟回报一次。陆照临把普通灯交给他，自己只带残印。",
        "evidenceParagraphId": "paragraph-016",
        "lineRange": {
          "start": 8422,
          "end": 8422
        }
      },
      {
        "text": "探路队在第一处塌方前停下，守卫把沿途的灯架位置画在图上，标明哪一处地面会回声。陆照临看完后决定把这份图交给城中孩子抄写，让更多人知道如何避开灵潮。",
        "evidenceParagraphId": "paragraph-017",
        "lineRange": {
          "start": 8424,
          "end": 8424
        }
      },
      {
        "text": "守灯人把交接时刻写在门柱上，约定下一班人不得提前离开，也不得把责任推给尚未到岗者。陆照临在旁签下自己的名字，随后把灯交给城门守卫。",
        "evidenceParagraphId": "paragraph-018",
        "lineRange": {
          "start": 8426,
          "end": 8426
        }
      }
    ],
