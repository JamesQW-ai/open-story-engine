{
  "schemaVersion": "story-package-beat-module/0.1",
  "package": {
    "id": "taixu-relics-part1",
    "version": "0.1.0"
  },
  "chapter": {
    "id": "chapter-027",
    "title": "：无相镜"
  },
  "beat": {
    "id": "beat_chapter_145",
    "nodeId": "node_source_continuity",
    "summary": "“她在我父亲离开前见过他。”",
    "narrativeBrief": [
      {
        "text": "第一道劫雷落下后，雪原恢复了声音。",
        "evidenceParagraphId": "paragraph-001",
        "lineRange": {
          "start": 4613,
          "end": 4613
        }
      },
      {
        "text": "雪花重新坠落，玄霄宗弟子的剑锋继续向前，顾长离伸出的手终于碰到陆照临的肩。第三盏灯却已经不在原地，只留下一圈青色火痕。",
        "evidenceParagraphId": "paragraph-002",
        "lineRange": {
          "start": 4615,
          "end": 4615
        }
      },
      {
        "text": "陆照临跪在雪地里，气海中的金色裂纹仍在扩大。每扩大一寸，他便会忘记一件事。先是母亲的声音，接着是北河城旧屋的门向哪边开，再后来，他连自己第一次握住灯的年纪都想不起了。",
        "evidenceParagraphId": "paragraph-003",
        "lineRange": {
          "start": 4617,
          "end": 4617
        }
      },
      {
        "text": "“别让他继续借火。”顾长离说。",
        "evidenceParagraphId": "paragraph-004",
        "lineRange": {
          "start": 4619,
          "end": 4619
        }
      },
      {
        "text": "叶观澜看向雪原深处：“不借火，他撑不过第二道劫雷。”",
        "evidenceParagraphId": "paragraph-005",
        "lineRange": {
          "start": 4621,
          "end": 4621
        }
      },
      {
        "text": "“借火会失去更多。”",
        "evidenceParagraphId": "paragraph-006",
        "lineRange": {
          "start": 4623,
          "end": 4623
        }
      },
      {
        "text": "“那就让他自己选。”",
        "evidenceParagraphId": "paragraph-007",
        "lineRange": {
          "start": 4625,
          "end": 4625
        }
      },
      {
        "text": "陆照临撑起身体：“我还能走。”",
        "evidenceParagraphId": "paragraph-008",
        "lineRange": {
          "start": 4627,
          "end": 4627
        }
      },
      {
        "text": "灰袍修士带着两名弟子逼近。慧闻没有出现，玄霄宗的白玉令牌在雪光中泛着冷色。",
        "evidenceParagraphId": "paragraph-009",
        "lineRange": {
          "start": 4629,
          "end": 4629
        }
      },
      {
        "text": "“交出残印。”灰袍修士说，“宗门会替你压下劫雷。”",
        "evidenceParagraphId": "paragraph-010",
        "lineRange": {
          "start": 4631,
          "end": 4631
        }
      },
      {
        "text": "“代价是交出名字？”",
        "evidenceParagraphId": "paragraph-011",
        "lineRange": {
          "start": 4633,
          "end": 4633
        }
      },
      {
        "text": "“代价是服从。”",
        "evidenceParagraphId": "paragraph-012",
        "lineRange": {
          "start": 4635,
          "end": 4635
        }
      },
      {
        "text": "顾长离抬起铜针：“你们把服从说得很像救命。”",
        "evidenceParagraphId": "paragraph-013",
        "lineRange": {
          "start": 4637,
          "end": 4637
        }
      },
      {
        "text": "灰袍修士看向她：“顾氏后代，你也有债。”",
        "evidenceParagraphId": "paragraph-014",
        "lineRange": {
          "start": 4639,
          "end": 4639
        }
      },
      {
        "text": "顾长离脸色微变。",
        "evidenceParagraphId": "paragraph-015",
        "lineRange": {
          "start": 4641,
          "end": 4641
        }
      },
      {
        "text": "“你们的旧库已经烧毁。”灰袍修士继续道，“可顾氏的债契还在宗门。只要她交出陆照临，宗门可以撤销债契。”",
        "evidenceParagraphId": "paragraph-016",
        "lineRange": {
          "start": 4643,
          "end": 4643
        }
      },
      {
        "text": "陆照临看向顾长离：“别答应。”",
        "evidenceParagraphId": "paragraph-017",
        "lineRange": {
          "start": 4645,
          "end": 4645
        }
      },
      {
        "text": "“我知道。”",
        "evidenceParagraphId": "paragraph-018",
        "lineRange": {
          "start": 4647,
          "end": 4647
        }
      },
      {
        "text": "灰袍修士抬手，身后弟子展开一卷白纸。纸上浮出顾长离的姓名，旁边写着“未偿债一笔”。",
        "evidenceParagraphId": "paragraph-019",
        "lineRange": {
          "start": 4649,
          "end": 4649
        }
      },
      {
        "text": "“你若拒绝，顾氏所有旁支都将被列为封存工程同谋。”",
        "evidenceParagraphId": "paragraph-020",
        "lineRange": {
          "start": 4651,
          "end": 4651
        }
      },
      {
        "text": "顾长离盯着白纸：“他们本来就是。”",
        "evidenceParagraphId": "paragraph-021",
        "lineRange": {
          "start": 4653,
          "end": 4653
        }
      },
      {
        "text": "“你叔父呢？”",
        "evidenceParagraphId": "paragraph-022",
        "lineRange": {
          "start": 4655,
          "end": 4655
        }
      },
      {
        "text": "“他拒绝过。”",
        "evidenceParagraphId": "paragraph-023",
        "lineRange": {
          "start": 4657,
          "end": 4657
        }
      },
      {
        "text": "“所以才把债传给你。”",
        "evidenceParagraphId": "paragraph-024",
        "lineRange": {
          "start": 4659,
          "end": 4659
        }
      },
      {
        "text": "顾长离握紧铜针，针尖刺入掌心。血滴落在雪上，立刻结成一朵暗红色的花。",
        "evidenceParagraphId": "paragraph-025",
        "lineRange": {
          "start": 4661,
          "end": 4661
        }
      },
      {
        "text": "叶观澜忽然走到灰袍修士面前：“你们只带了三个人，说明山门还不知道这里发生了什么。”",
        "evidenceParagraphId": "paragraph-026",
        "lineRange": {
          "start": 4663,
          "end": 4663
        }
      },
      {
        "text": "“你想拖延？”",
        "evidenceParagraphId": "paragraph-027",
        "lineRange": {
          "start": 4665,
          "end": 4665
        }
      },
      {
        "text": "“我想告诉你，第三盏灯已经进入旧驿道。”",
        "evidenceParagraphId": "paragraph-028",
        "lineRange": {
          "start": 4667,
          "end": 4667
        }
      },
      {
        "text": "灰袍修士的目光一沉：“你怎么知道？”",
        "evidenceParagraphId": "paragraph-029",
        "lineRange": {
          "start": 4669,
          "end": 4669
        }
      },
      {
        "text": "“因为我看见它。”",
        "evidenceParagraphId": "paragraph-030",
        "lineRange": {
          "start": 4671,
          "end": 4671
        }
      },
      {
        "text": "“你没有看见。”",
        "evidenceParagraphId": "paragraph-031",
        "lineRange": {
          "start": 4673,
          "end": 4673
        }
      },
      {
        "text": "“那你为什么紧张？”",
        "evidenceParagraphId": "paragraph-032",
        "lineRange": {
          "start": 4675,
          "end": 4675
        }
      },
      {
        "text": "灰袍修士挥剑斩向叶观澜。叶观澜侧身避开，剑锋擦过肩头，血雾在雪中散开。顾长离趁机弹出铜针，钉住白纸一角。",
        "evidenceParagraphId": "paragraph-033",
        "lineRange": {
          "start": 4677,
          "end": 4677
        }
      },
      {
        "text": "无脸人抬起旧印，向顾长离伸出手。",
        "evidenceParagraphId": "paragraph-046",
        "lineRange": {
          "start": 4703,
          "end": 4703
        }
      },
      {
        "text": "灰袍修士后退一步：“封存者的影子怎么会离开灵城？”",
        "evidenceParagraphId": "paragraph-047",
        "lineRange": {
          "start": 4705,
          "end": 4705
        }
      },
      {
        "text": "叶观澜低声道：“有人把它带出来了。”",
        "evidenceParagraphId": "paragraph-048",
        "lineRange": {
          "start": 4707,
          "end": 4707
        }
      },
      {
        "text": "无脸人转向灰袍修士，嘴角裂开一道缝。缝里没有声音，只有一行青字浮出：",
        "evidenceParagraphId": "paragraph-049",
        "lineRange": {
          "start": 4709,
          "end": 4709
        }
      },
      {
        "text": "“顾氏债契，转交玄霄宗。”",
        "evidenceParagraphId": "paragraph-050",
        "lineRange": {
          "start": 4711,
          "end": 4711
        }
      },
      {
        "text": "白纸上的顾长离姓名立刻变黑。她闷哼一声，膝盖差点跪进雪里。",
        "evidenceParagraphId": "paragraph-051",
        "lineRange": {
          "start": 4713,
          "end": 4713
        }
      },
      {
        "text": "“他们把债转给宗门了。”陆照临说。",
        "evidenceParagraphId": "paragraph-052",
        "lineRange": {
          "start": 4715,
          "end": 4715
        }
      },
      {
        "text": "“不是他们。”叶观澜看向无脸人，“是第三盏灯。”",
        "evidenceParagraphId": "paragraph-053",
        "lineRange": {
          "start": 4717,
          "end": 4717
        }
      },
      {
        "text": "无脸人将旧印按向雪地。雪面裂开一道缝，露出一条通往山谷的暗道。暗道两侧嵌着许多空灯槽，最深处有微弱青光。",
        "evidenceParagraphId": "paragraph-054",
        "lineRange": {
          "start": 4719,
          "end": 4719
        }
      },
      {
        "text": "“走。”顾长离咬牙。",
        "evidenceParagraphId": "paragraph-055",
        "lineRange": {
          "start": 4721,
          "end": 4721
        }
      },
      {
        "text": "陆照临伸手扶她。就在两人踏入暗道时，叶观澜忽然停下。",
        "evidenceParagraphId": "paragraph-056",
        "lineRange": {
          "start": 4723,
          "end": 4723
        }
      },
      {
        "text": "“你们先走。”",
        "evidenceParagraphId": "paragraph-057",
        "lineRange": {
          "start": 4725,
          "end": 4725
        }
      },
      {
        "text": "“你呢？”",
        "evidenceParagraphId": "paragraph-058",
        "lineRange": {
          "start": 4727,
          "end": 4727
        }
      },
      {
        "text": "“我要留下。”",
        "evidenceParagraphId": "paragraph-059",
        "lineRange": {
          "start": 4729,
          "end": 4729
        }
      },
      {
        "text": "“为什么？”",
        "evidenceParagraphId": "paragraph-060",
        "lineRange": {
          "start": 4731,
          "end": 4731
        }
      },
      {
        "text": "“有人必须让玄霄宗相信你们去了北门。”",
        "evidenceParagraphId": "paragraph-061",
        "lineRange": {
          "start": 4733,
          "end": 4733
        }
      },
      {
        "text": "陆照临看着他：“你要替我们引开追兵？”",
        "evidenceParagraphId": "paragraph-062",
        "lineRange": {
          "start": 4735,
          "end": 4735
        }
      },
      {
        "text": "“不全是。”",
        "evidenceParagraphId": "paragraph-063",
        "lineRange": {
          "start": 4737,
          "end": 4737
        }
      },
      {
        "text": "“还有什么？”",
        "evidenceParagraphId": "paragraph-064",
        "lineRange": {
          "start": 4739,
          "end": 4739
        }
      },
      {
        "text": "叶观澜把一枚黑色蜡片塞进陆照临手里：“归墟盟有人把你们的路线交给了玄霄宗。不是我。”",
        "evidenceParagraphId": "paragraph-065",
        "lineRange": {
          "start": 4741,
          "end": 4741
        }
      },
      {
        "text": "灯在。",
        "evidenceParagraphId": "paragraph-101",
        "lineRange": {
          "start": 4813,
          "end": 4813
        }
      },
      {
        "text": "镜面灰雾散开，出现一间北河城的旧屋。年幼的陆照临坐在床边，陆沉舟将一盏空灯放在他膝上。屋外有人争吵，声音断断续续，只能听见“太虚”“封存”“不能留下”几个词。",
        "evidenceParagraphId": "paragraph-034",
        "lineRange": {
          "start": 4887,
          "end": 4887
        }
      },
      {
        "text": "陆沉舟蹲在他面前：“如果我不回来，你就去玄霄宗。”",
        "evidenceParagraphId": "paragraph-035",
        "lineRange": {
          "start": 4889,
          "end": 4889
        }
      },
      {
        "text": "“为什么？”",
        "evidenceParagraphId": "paragraph-036",
        "lineRange": {
          "start": 4891,
          "end": 4891
        }
      },
      {
        "text": "“因为那里有人记得我。”",
        "evidenceParagraphId": "paragraph-037",
        "lineRange": {
          "start": 4893,
          "end": 4893
        }
      },
      {
        "text": "“谁？”",
        "evidenceParagraphId": "paragraph-038",
        "lineRange": {
          "start": 4895,
          "end": 4895
        }
      },
      {
        "text": "陆沉舟没有回答。他将灰白石片按进陆照临胸口，石片化作青光，融入心脉。",
        "evidenceParagraphId": "paragraph-039",
        "lineRange": {
          "start": 4897,
          "end": 4897
        }
      },
      {
        "text": "年幼的陆照临疼得哭出声。",
        "evidenceParagraphId": "paragraph-040",
        "lineRange": {
          "start": 4899,
          "end": 4899
        }
      },
      {
        "text": "沈砚秋站在门外，手里提着第三盏灯。她没有进屋，只把灯放在门槛上。",
        "evidenceParagraphId": "paragraph-041",
        "lineRange": {
          "start": 4901,
          "end": 4901
        }
      },
      {
        "text": "镜面忽然裂开。",
        "evidenceParagraphId": "paragraph-042",
        "lineRange": {
          "start": 4903,
          "end": 4903
        }
      },
      {
        "text": "陆照临退后一步，胸口剧痛。一个陌生名字从他舌尖滑出：“沈砚秋。”",
        "evidenceParagraphId": "paragraph-043",
        "lineRange": {
          "start": 4905,
          "end": 4905
        }
      },
      {
        "text": "“你看见了什么？”顾长离问。",
        "evidenceParagraphId": "paragraph-044",
        "lineRange": {
          "start": 4907,
          "end": 4907
        }
      },
      {
        "text": "“她在我父亲离开前见过他。”",
        "evidenceParagraphId": "paragraph-045",
        "lineRange": {
          "start": 4909,
          "end": 4909
        }
      }
    ],
