  "chapter": {
    "id": "chapter-047",
    "title": "人间留白"
  },
  "beat": {
    "id": "beat_chapter_313",
    "nodeId": "node_source_continuity",
    "summary": "顾长离为每个瓶子加上取回日期，年轻人终于在第七日写下父亲的名字。",
    "narrativeBrief": [
      {
        "text": "河滩决定后的第二日，北河城把三方凭证分别送往城门、灵脉井和老槐树。陆照临没有随任何一方行动，而是带着顾长离沿河检查新立的灯架。",
        "evidenceParagraphId": "paragraph-001",
        "lineRange": {
          "start": 8392,
          "end": 8392
        }
      },
      {
        "text": "傍晚，灵脉井忽然发出低鸣。井水没有上涨，却把河滩的三块石台倒映在水面。顾长离发现倒影中多出一道云门，门后没有修士，只有一条通往北境的阶梯。",
        "evidenceParagraphId": "paragraph-002",
        "lineRange": {
          "start": 8394,
          "end": 8394
        }
      },
      {
        "text": "城中百姓连夜分组。铁匠守火，抄写员守账，孩子们负责传递消息。没有人等待宗门发号施令。陆照临将撤离路线画在城墙上，标明每处可能塌陷的屋舍。",
        "evidenceParagraphId": "paragraph-003",
        "lineRange": {
          "start": 8396,
          "end": 8396
        }
      },
      {
        "text": "天门前夜，城中没有举行祭典。陆照临把三盏灯分给三组普通人：铁匠、失名者和守城少年。每组都得到一份相同的引火诀，却被告知灯若熄灭，不会有人替他们重燃。",
        "evidenceParagraphId": "paragraph-004",
        "lineRange": {
          "start": 8398,
          "end": 8398
        }
      },
      {
        "text": "天门前夜，北河城开始下反常的白雨。雨滴落在屋瓦上没有声音，落在人身上却会带走一段细小记忆。铁匠忘了自己学会打铁的年份，守城少年忘了母亲的发色，失名者忘了曾经害怕什么。",
        "evidenceParagraphId": "paragraph-005",
        "lineRange": {
          "start": 8400,
          "end": 8400
        }
      },
      {
        "text": "三组普通人轮流守灯。第一组负责看火，第二组负责记账，第三组负责照看撤离的老人和孩子。有人提议把灯交给修士，铁匠拒绝了，说修士已经替他们决定太久。",
        "evidenceParagraphId": "paragraph-006",
        "lineRange": {
          "start": 8402,
          "end": 8402
        }
      },
      {
        "text": "陆照临与陆沉舟在门下短暂相见。父亲没有劝他进入天门，只问他是否还记得北河城的雨声。陆照临诚实地说已经忘了。陆沉舟点头，说忘记也可以，只要有人愿意告诉他雨曾经来过。",
        "evidenceParagraphId": "paragraph-007",
        "lineRange": {
          "start": 8404,
          "end": 8404
        }
      },
      {
        "text": "阶梯尽头的云门要求每个人交出一件东西。叶观澜交出归墟盟令，沈砚秋交出白骨书的封皮，顾长离交出那块写着替身的木牌。陆照临没有东西可交，便说自己愿意交出被天门规定的未来。",
        "evidenceParagraphId": "paragraph-008",
        "lineRange": {
          "start": 8450,
          "end": 8450
        }
      },
      {
        "text": "夜色落下，河滩上的灯一盏接一盏亮起。每个人都带走自己的选择，也留下可供后来者追问的证据。",
        "evidenceParagraphId": "paragraph-009",
        "lineRange": {
          "start": 8452,
          "end": 8452
        }
      },
      {
        "text": "留白决定后的第五日，南街的争执扩大到三条巷子。有人认为接住记忆的人会比别人拥有更多，有人担心放弃记忆的人将来会被指责。顾长离把两种名单都撕开，让居民重新面对面说话。",
        "evidenceParagraphId": "paragraph-010",
        "lineRange": {
          "start": 8454,
          "end": 8454
        }
      },
      {
        "text": "陆照临带着孩子们把微光装进透明的小瓶。接住的人在瓶身写下名字，放弃的人则写下放弃的日期。瓶子不按结果排列，而按街道排列。",
        "evidenceParagraphId": "paragraph-011",
        "lineRange": {
          "start": 8456,
          "end": 8456
        }
      },
      {
        "text": "夜里，云层中的阶梯下降到城墙外。阶梯没有门，也没有守卫，只有一阵持续的风。风吹过时，居民听见各自已经放弃的声音。有人听见亡亲唱歌，有人听见自己年轻时的誓言。",
        "evidenceParagraphId": "paragraph-012",
        "lineRange": {
          "start": 8458,
          "end": 8458
        }
      },
      {
        "text": "一名年轻人走到阶梯前，承认自己曾故意放弃父亲的名字，因为那名字让他无法继续生活。他问陆照临是否应该把名字接回来。陆照临说没人能替他决定，只能告诉他接回后会重新承担悲伤。",
        "evidenceParagraphId": "paragraph-013",
        "lineRange": {
          "start": 8460,
          "end": 8460
        }
      },
      {
        "text": "风停后，阶梯没有升高，也没有消失。沈砚秋把空册交给各街区，让他们每月补写一次。叶观澜则在城墙上钉下撤离路线，承诺若天门再次震动，先带孩子和老人离开。",
        "evidenceParagraphId": "paragraph-014",
        "lineRange": {
          "start": 8462,
          "end": 8462
        }
      },
      {
        "text": "阶梯下的人间逐渐恢复日常。有人仍会在夜里听见被放弃的声音，却学会把门留一道缝，让声音经过而不留下。顾长离把失去祖屋门向的记忆画成一扇没有方向的门，挂在南街。",
        "evidenceParagraphId": "paragraph-015",
        "lineRange": {
          "start": 8464,
          "end": 8464
        }
      },
      {
        "text": "阶梯的风渐渐变轻，孩子们把空瓶收回各家。有人仍在犹豫，守灯人便告诉他们，犹豫本身也可以登记，不必急着回答。",
        "evidenceParagraphId": "paragraph-016",
        "lineRange": {
          "start": 8466,
          "end": 8466
        }
      },
      {
        "text": "顾长离把各家瓶子按街道归档，规定任何人取回记忆都要有见证者。南街年轻人带着空瓶回来，说他仍未决定是否接回父亲的名字。她没有催促，只让他坐在灯下听雨。",
        "evidenceParagraphId": "paragraph-017",
        "lineRange": {
          "start": 8468,
          "end": 8468
        }
      },
      {
        "text": "孩子们在墙上画出回家的标志，标志旁写着画图人的名字。顾长离说，能被找到就是一种新的记忆。",
        "evidenceParagraphId": "paragraph-018",
        "lineRange": {
          "start": 8470,
          "end": 8470
        }
      },
      {
        "text": "南街的人把争执过的旧木牌保留下来，挂在新灯旁，提醒后来者这条街曾经如何分歧。顾长离为每个瓶子加上取回日期，年轻人终于在第七日写下父亲的名字。",
        "evidenceParagraphId": "paragraph-019",
        "lineRange": {
          "start": 8472,
          "end": 8472
        }
      }
    ],
