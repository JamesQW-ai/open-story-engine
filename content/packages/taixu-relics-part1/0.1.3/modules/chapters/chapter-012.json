  "facts": [
    {
      "id": "fact_5bd4f5e794fb",
      "text": "老妇的手停在半空。",
      "sourceChapterId": "chapter-012",
      "sourceProgress": "chapter_063",
      "lineRange": {
        "start": 1913,
        "end": 1913
      }
    },
    {
      "id": "fact_a89023cd713e",
      "text": "声音从客舍门前向镇外延伸，最终停在石碑旁。",
      "sourceChapterId": "chapter-012",
      "sourceProgress": "chapter_064",
      "lineRange": {
        "start": 2055,
        "end": 2055
      }
    },
    {
      "id": "fact_657fdd6720c8",
      "text": "还有一行，直接停在客舍门前。",
      "sourceChapterId": "chapter-012",
      "sourceProgress": "chapter_064",
      "lineRange": {
        "start": 2065,
        "end": 2065
      }
    },
    {
      "id": "fact_80f9f61ab2fa",
      "text": "陆照临听见自己的呼吸，也听见门外那行脚印停在了门槛前。",
      "sourceChapterId": "chapter-012",
      "sourceProgress": "chapter_064",
      "lineRange": {
        "start": 2092,
        "end": 2092
      }
    }
  ],
  "timeline": [
