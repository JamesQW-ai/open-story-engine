  "facts": [
    {
      "id": "fact_fe0ebb6a9278",
      "text": "里面没有黑暗，远处有一盏红色故障灯一闪一闪，把积水照得像浑浊的血。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_008",
      "lineRange": {
        "start": 231,
        "end": 231
      }
    },
    {
      "id": "fact_c4d45f714b4e",
      "text": "他知道排水泵撑不到这个雨季，却还把故障写成‘已排除’。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_008",
      "lineRange": {
        "start": 237,
        "end": 237
      }
    },
    {
      "id": "fact_eb2a65fe10d2",
      "text": "图纸上那条备用排水沟被碎石堵住了，如果不先开阀，水会继续往信号室倒灌。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_008",
      "lineRange": {
        "start": 249,
        "end": 249
      }
    },
    {
      "id": "fact_012dfc6a9412",
      "text": "一下，两下，第三下时，金属终于断开。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_008",
      "lineRange": {
        "start": 329,
        "end": 329
      }
    }
  ],
  "timeline": [
    {
      "id": "timeline_f0e9c130a596",
      "order": 8,
      "knownAtStart": false,
      "description": "姜序刷开通行证，门刚开一条缝，冷风就裹着水汽扑出来。"
    },
    {
      "id": "timeline_5b43c30c55c1",
      "order": 9,
      "knownAtStart": false,
      "description": "他想起姜序说过，手动阀一开，水压会暂时下降；可在那之前，门外的卡栓必须被撬开。"
    },
    {
      "id": "timeline_f5e1d20d2671",
      "order": 10,
      "knownAtStart": false,
      "description": "许川把录音笔递给她。"
    }
  ],
