  "facts": [
    {
      "id": "fact_18f95085f3b7",
      "text": "调度台上的屏幕亮着，画面停在列车放行记录。",
      "sourceChapterId": "chapter-002",
      "sourceProgress": "chapter_003",
      "lineRange": {
        "start": 119,
        "end": 119
      }
    },
    {
      "id": "fact_16fdc2792917",
      "text": "记录页上，二十三点四十七分的检修申请被标记为“已完成”，可屏幕右下角的设备状态却显示：信号室排水泵故障，备用电池剩余四十五分钟。",
      "sourceChapterId": "chapter-002",
      "sourceProgress": "chapter_003",
      "lineRange": {
        "start": 155,
        "end": 155
      }
    }
  ],
  "timeline": [
    {
      "id": "timeline_49a5cf7aacf3",
      "order": 3,
      "knownAtStart": false,
      "description": "许川推开门时，铁门发出一声尖锐的摩擦声，仿佛整座车站都听见了。"
    },
    {
      "id": "timeline_2770c12a6368",
      "order": 4,
      "knownAtStart": false,
      "description": "许川踩上纸箱，推开小窗翻进去，落地时手掌被桌角划出一道浅口。"
    },
    {
      "id": "timeline_de397fa0466c",
      "order": 5,
      "knownAtStart": false,
      "description": "许川用手机拍下屏幕和撕下的日志。"
    },
    {
      "id": "timeline_fa18c24e7049",
      "order": 6,
      "knownAtStart": false,
      "description": "许川把录音笔塞进内袋，抓起柜里的维修图纸。"
    },
    {
      "id": "timeline_0b6fa1710e31",
      "order": 7,
      "knownAtStart": false,
      "description": "他把应急灯递给许川。"
    }
  ],
