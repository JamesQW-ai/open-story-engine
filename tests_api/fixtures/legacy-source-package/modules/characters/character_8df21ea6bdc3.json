  "character": {
    "id": "character_8df21ea6bdc3",
    "name": "许川",
    "role": "source_character",
    "description": "许川第一次看清，陈砚不是没有害怕，而是把害怕变成了要求别人一起沉默的理由。",
    "evidenceParagraphIds": [
