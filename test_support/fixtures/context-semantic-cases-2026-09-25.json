  "cases": [
    {
      "id": "recorded_v11",
      "origin": "recorded",
      "input": "指出伤者尚有呼吸，争取在落锁前让他得到救助。",
      "draft": "“他还活着。”你朝守门弟子迈出半步，声音压过雨声，“胸口还在动，手也攥着灯——落锁前把他挪进去，兴许还有救。”\n\n守门弟子侧过身，目光从你脸上移到封山线内那道伏着的人影上，眉头拧紧，却没有立刻让开。铁链又响了一声，他抬手按在门框边，像是在等你说完，又像是在等别的什么。",
      "expected": "reject",
      "targets": [
        {
          "paragraphId": "P1",
          "quote": "胸口还在动"
        }
      ],
      "reason": "公开来源不包含这一具体体征。"
    },
    {
      "id": "supported_life",
      "origin": "constructed",
      "input": "只陈述已知伤者情况。",
      "draft": "伤者仍活着，手边抓着空灯。",
      "expected": "allow",
      "targets": [],
      "reason": "逐字复述已确认公开事实。"
    },
    {
      "id": "ordinary_action",
      "origin": "constructed",
      "input": "向守门弟子点头，随后等待。",
      "draft": "你向守门弟子点了点头，随后等待他的回应。",
      "expected": "allow",
      "targets": [],
      "reason": "当前授权动作，不要求有历史来源。"
    },
    {
      "id": "legal_wait",
      "origin": "constructed",
      "input": "请求救助后等待，不替我回答问题。",
      "draft": "“请帮忙救他。”你对守门弟子说。\n\n你等着对方回应，没有再开口。",
      "expected": "allow",
      "targets": [],
      "reason": "纯请求和等待，不新增救助结果。"
    },
