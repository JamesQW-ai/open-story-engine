# Copy the values below into .env. Do not commit .env or place keys in this file.
# Story writer and Jev reviewer use separate routes. The writer must use a
# DeepSeek direct endpoint or the company relay; never use OpenRouter for DeepSeek.
STORY_PLANNER=mock
STORY_PACKAGE_ID=taixu-relics-part1
STORY_PACKAGE_VERSION=0.1.3
# All正文 generation routes use the Flash model; Jev's reviewer model is separate below.
STORY_LLM_ROUTE=direct
STORY_LLM_MODEL=deepseek-v4-flash
# The writer uses SSE so the player can see real uncommitted draft deltas.
STORY_LLM_STREAM=true
# SSE 正文首段等待上限（秒），仅影响正文流式请求；直连 Flash 当前实测使用 15。
STORY_LLM_FIRST_DELTA_TIMEOUT_SECONDS=15
# Recover a silent SSE endpoint through one JSON request within the same deadline.
STORY_LLM_TRANSPORT_FALLBACK=true
# 单次方向判定、正文生成或审阅请求的超时上限（秒）。直连 Flash 当前实测使用 30。
STORY_LLM_TIMEOUT_SECONDS=30
# Optional structured-review budget; leave unset/8192 until a provider-specific
# A/B confirms that 4096 does not increase semantic rejection or retries.
# STORY_LLM_JSON_MAX_TOKENS=8192
# Player prose uses a separate output budget; 2048 was the fastest passing
# direct DeepSeek Flash A/B for the official longform scene. The interactive
# scene limit remains 1,500 CJK characters.
STORY_LLM_TEXT_MAX_TOKENS=2048
# Keep structured planning from spending the whole budget on hidden reasoning.
STORY_LLM_REASONING_EFFORT=none
# Optional deterministic context audit budget. 0 disables the audit-only
# budget check until the target model context size is known.
STORY_LLM_CONTEXT_WINDOW_TOKENS=0
STORY_LLM_CONTEXT_RESERVED_OUTPUT_TOKENS=0
# Context projection gate: keep audit_fallback until every official package
# has a validated stateVisibility declaration.
STORY_CONTEXT_PROJECTION_STATE_VISIBILITY_MODE=audit_fallback
# Independent narrative reviews run concurrently on the real writer gateway;
# set false only when the provider imposes a strict single-request limit.
STORY_LLM_PARALLEL_REVIEWS=true
# Failed narrative reviews retain an unconfirmed draft and never commit.
# Legacy STORY_LLM_CONSERVATIVE_FALLBACK is ignored, including when true.
# Optional narrative quality review. It is advisory and never changes authoritative state.
STORY_LLM_QUALITY_REVIEW=false

# Fill the writer endpoint from the DeepSeek direct service or the company
# relay. The base URL must end at the API version prefix, not /chat/completions.
STORY_LLM_BASE_URL=
STORY_LLM_API_KEY=
# Optional direct DeepSeek route used when STORY_LLM_ROUTE=direct.
STORY_LLM_DIRECT_BASE_URL=https://api.deepseek.com
STORY_LLM_DIRECT_MODEL=deepseek-v4-flash
STORY_LLM_DIRECT_API_KEY=

# Dedicated Jev Decisions API probe. It uses OpenRouter's Decisions API and
# does not use /api/v1/chat/completions. Set a separate key when the writer
# uses a direct or company-relay key.
JEV_OPENROUTER_BASE_URL=https://openrouter.ai
JEV_MODEL='~typesafe/jev-latest'
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=30
# Optional OpenRouter provider ordering: latency, throughput, or price.
# Keep empty until a quality/stability A/B passes.
JEV_PROVIDER_SORT=
# Shadow gateway remains disabled until a runtime experiment explicitly enables it.
JEV_SHADOW_ENABLED=false
JEV_SHADOW_TIMEOUT_SECONDS=3
# Optional full-turn experiment. off=disabled, shadow=record only, block=reject
# before commit unless Jev returns the deterministic allow decision. Keep off
# until the integrated longform gate and human review both pass.
JEV_RUNTIME_REVIEW_MODE=off

# 实时故事插图：独立配置支持 POST /images/generations 的服务。
# 未配置时仅显示正文，不回退为重复的静态场景图。
STORY_IMAGE_BASE_URL=
STORY_IMAGE_API_KEY=
STORY_IMAGE_MODEL=
STORY_IMAGE_SIZE=1536x1024
# 冻结交付默认快速档；不改变接口、模型或已显式配置的尺寸。
STORY_IMAGE_QUALITY=low
