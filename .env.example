# Copy the values below into .env. Do not commit .env or place keys in this file.
# The MVP default is the fast narrative model selected for the first live test.
STORY_PLANNER=openai
STORY_LLM_MODEL=deepseek-v4-flash:cloud
# The interactive CLI renders uncommitted narrative previews from SSE, then validates before persistence.
# Set false only when diagnosing an endpoint with unreliable SSE responses.
STORY_LLM_STREAM=true
# 单次方向判定、正文生成或审阅请求的超时上限（秒）。
STORY_LLM_TIMEOUT_SECONDS=30
# Optional narrative quality review. It is advisory and never changes authoritative state.
STORY_LLM_QUALITY_REVIEW=false

# Fill both values from the subscription that exposes the selected model.
# The base URL must end at the API version prefix, not /chat/completions.
STORY_LLM_BASE_URL=
STORY_LLM_API_KEY=
