  "facts": [
    {
      "id": "fact_c4d45f714b4e",
      "text": "他知道排水泵撑不到这个雨季，却还把故障写成‘已排除’。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_009",
      "lineRange": {
        "start": 237,
        "end": 237
      }
    },
    {
      "id": "fact_eb2a65fe10d2",
      "text": "图纸上那条备用排水沟被碎石堵住了，如果不先开阀，水会继续往信号室倒灌。",
      "sourceChapterId": "chapter-003",
      "sourceProgress": "chapter_009",
      "lineRange": {
        "start": 249,
        "end": 249
      }
    }
  ],
